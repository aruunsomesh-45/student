# ==============================================================================
# MindConnect Platform — Environment Configuration EXAMPLE
# ==============================================================================
# Copy this file to .env and fill in real values.
# NEVER commit your actual .env file to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Django Core Settings
# ------------------------------------------------------------------------------
# Generate a secure key with: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=your-50+-char-random-secret-key-here

# Set to False in production
DEBUG=False

# Comma-separated list of allowed domains/IPs
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com

# Set to True when deploying behind HTTPS (enables HSTS, secure cookies, SSL redirect)
FORCE_HTTPS=True

# ------------------------------------------------------------------------------
# 2. Supabase Configuration
# Obtain from: https://app.supabase.com/project/_/settings/api
# ------------------------------------------------------------------------------
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ------------------------------------------------------------------------------
# 3. PostgreSQL Database (optional — omit to use SQLite)
# ------------------------------------------------------------------------------
# DATABASE_URL=postgresql://postgres:your_password@db.your_project_ref.supabase.co:5432/postgres

# ------------------------------------------------------------------------------
# 4. Google OAuth Credentials
# Obtain from: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: https://yourdomain.com/accounts/google/login/callback/
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ------------------------------------------------------------------------------
# 5. AI Pedagogical Co-Pilot Engine Key (optional)
# ------------------------------------------------------------------------------
AI_API_KEY=your-ai-api-key

# ------------------------------------------------------------------------------
# 6. Session Configuration (optional)
# ------------------------------------------------------------------------------
# SESSION_COOKIE_AGE=1209600
